# ============================================================================
# Music School Platform — environment template
# Copy to .env.local and fill in. One filled-in copy = one school deployment.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.
# ============================================================================

# ---- School branding (white-label) ----------------------------------------
# Apollo is the built-in default: if you leave ALL of these unset, the app is
# branded "Apollo Performing Arts & Academy" automatically (see
# src/config/school.ts). You only set these to run the SAME software for a
# DIFFERENT school — one filled-in copy of this file per school deployment.
#
# The values below are Apollo's (customer #1). For a second school, replace
# each value with theirs and deploy a separate instance.
NEXT_PUBLIC_SCHOOL_NAME="Apollo Performing Arts & Academy"
NEXT_PUBLIC_SCHOOL_ACCENT_WORD="Performing Arts"   # phrase in NAME highlighted in accent color
NEXT_PUBLIC_SCHOOL_SHORT_NAME="Apollo Academy"     # compact name shown in nav bars
NEXT_PUBLIC_SCHOOL_TAGLINE="Elevate your musicality with our signature learning tiers. Choose your path and begin your transformation today."
NEXT_PUBLIC_SCHOOL_DESCRIPTION="High-fidelity live music lessons and masterclasses."
NEXT_PUBLIC_SCHOOL_FOOTER_TAGLINE="Excellence in Performance"
NEXT_PUBLIC_SCHOOL_URL="https://www.apollotunes.com"
NEXT_PUBLIC_SCHOOL_EMAIL="support@apollotunes.com"
NEXT_PUBLIC_SCHOOL_LOGO="/logo.png"             # place file in /public
NEXT_PUBLIC_SCHOOL_OG_IMAGE="/og-image.png"     # 1200x630 in /public
NEXT_PUBLIC_APP_URL="https://musicschool-platform.vercel.app"   # deployed app origin

# ---- Database (Neon Postgres) ----------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Auth: Clerk -----------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_xxx"
CLERK_SECRET_KEY="sk_live_xxx"

# ---- Auth: custom admin panel ----------------------------------------------
ADMIN_USER="admin@springfieldmusic.com"
ADMIN_PASS="use-a-long-random-passphrase"
JWT_SECRET="generate-with: openssl rand -base64 32"   # signs the admin_session cookie

# ---- Payments: Stripe (use LIVE keys in production) ------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxx"
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"                # from the live webhook endpoint
NEXT_PUBLIC_STRIPE_PREMIUM_PLAN_PRICE_ID="price_xxx"   # the recurring plan's Price ID

# ---- Email: Resend ---------------------------------------------------------
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="Apollo Academy <billing@apolloperformingacademy.com>"  # domain must be Resend-verified

# ---- Live classrooms (at least one provider required for lessons) ----------
# Zoom Meeting SDK (https://marketplace.zoom.us) — for Zoom-based classrooms
NEXT_PUBLIC_ZOOM_SDK_KEY="xxx"
ZOOM_SDK_KEY="xxx"
ZOOM_SDK_SECRET="xxx"

# Jitsi JaaS (https://jaas.8x8.vc) — for Jitsi-based classrooms
NEXT_PUBLIC_JITSI_APP_ID="vpaas-magic-cookie-xxx"
JITSI_API="xxx"
JITSI_APPLE_API="xxx"
JITSI_PUBLIC_KEY="xxx"
JITSI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ---- Optional: Google Classroom integration --------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Optional: scheduled jobs ----------------------------------------------
CRON_SECRET="random-string-if-using-vercel-cron"
